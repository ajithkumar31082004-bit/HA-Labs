# HA Labs Environment Configuration Template
# NOTE: Never commit real credentials or secrets to version control.

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (PostgreSQL / MySQL ready)
DATABASE_URL=postgresql://halabs_user:change_me_securely@localhost:5432/halabs_db

# Cloud Storage (AWS S3 ready)
AWS_REGION=ap-south-1
AWS_S3_BUCKET=halabs-student-artifacts
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Security
JWT_SECRET=change_me_to_a_random_32_byte_secret_key_in_production
SESSION_COOKIE_NAME=ha_labs_session
